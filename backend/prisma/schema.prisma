// Vitalyn data model (PostgreSQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  // Everyone logs in with their mobile number and a one-time code.
  phone        String?  @unique
  email        String?  @unique
  name         String
  role         Role     @default(USER)
  // DPDP: when and to which notice version the user consented
  consentAt      DateTime?
  consentVersion String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Set for HOSPITAL staff and DOCTOR accounts
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  doctor     Doctor?

  appointments  Appointment[]
  profiles      PatientProfile[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  consents      ConsentRecord[]
  savedHospitals SavedHospital[]
}

/// "My hospitals": hospitals a patient saved for one-tap rebooking.
model SavedHospital {
  createdAt DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@id([userId, hospitalId])
}

/// One OTP sent to a phone. Only a hash of the code is stored.
model OtpChallenge {
  id         String     @id @default(cuid())
  phone      String
  purpose    OtpPurpose @default(LOGIN)
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

/// Long-lived session token kept in an httpOnly cookie. Rotated on every use.
model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A person the account holder books for: themselves or a family member.
model PatientProfile {
  id         String  @id @default(cuid())
  name       String
  age        Int?
  gender     Gender?
  relation   String  @default("Self") // Self, Mother, Father, Son, Daughter, Spouse, Other
  abhaNumber String? // optional ABHA (health ID), kept for ABDM later
  createdAt  DateTime @default(now())

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Hospital {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String?
  description String
  address     String
  city        String
  state       String
  pincode     String
  phone       String
  // Front-desk WhatsApp number (10 digits) for a "WhatsApp the desk" button; optional
  whatsapp    String?
  lat         Float
  lng         Float
  specialties String[]
  // Average of visible verified reviews (0 when there are none); recalculated on every change
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  beds        Int      @default(100)
  emergency24x7 Boolean @default(true)
  // Accent colour used for the hospital tile when no photo is set
  tone        String   @default("#1747E5")
  imageUrl    String?
  verified    Boolean  @default(true)
  // Registry identifiers checked by the platform admin
  registrationNo String?
  hfrId          String? // ABDM Health Facility Registry ID
  // Accreditations checked by the platform admin, e.g. NABH, NABL (facts only, no "best" badges)
  accreditations String[] @default([])
  createdAt   DateTime @default(now())

  doctors      Doctor[]
  events       Event[]
  promotions   Promotion[]
  appointments Appointment[]
  staff        User[]
  savedBy      SavedHospital[]
  reviews      Review[]
}

model Doctor {
  id          String  @id @default(cuid())
  name        String
  specialty   String
  qualification String
  experienceYears Int
  fee         Int // INR
  languages   String[] @default(["English", "Hindi"])
  // Weekly schedule: days are 0=Sun..6=Sat
  workingDays Int[]   @default([1, 2, 3, 4, 5, 6])
  startTime   String  @default("09:00")
  endTime     String  @default("13:00")
  slotMinutes Int     @default(15)
  // One approver per doctor: when true (default) bookings are confirmed instantly with a token;
  // when false the desk or the doctor accepts each request.
  autoConfirm Boolean @default(true)
  // State medical council or ABDM HPR registration number, checked by the platform admin
  registrationNo String?
  registrationVerifiedAt DateTime? // set when the platform admin has checked the registry
  // Inactive doctors disappear from booking but keep their history
  active      Boolean @default(true)

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id])

  appointments Appointment[]
  leaves       DoctorLeave[]
}

/// A hospital asking to join. The platform admin verifies it before it goes live.
model HospitalApplication {
  id             String            @id @default(cuid())
  status         ApplicationStatus @default(PENDING)
  hospitalName   String
  description    String
  address        String
  city           String
  state          String
  pincode        String
  phone          String
  lat            Float
  lng            Float
  specialties    String[]
  beds           Int?
  emergency24x7  Boolean           @default(false)
  registrationNo String
  hfrId          String?
  // The person who will run the hospital's Vitalyn desk account
  contactName    String
  contactEmail   String
  contactPhone   String // the desk logs in with this number by OTP
  consentAt      DateTime
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedById   String?
  hospitalId     String?           @unique
  createdAt      DateTime          @default(now())

  @@index([status])
  @@index([contactEmail])
}

/// A day the doctor is not seeing patients. Slots that day disappear.
model DoctorLeave {
  id        String   @id @default(cuid())
  date      String   @db.Char(10) // YYYY-MM-DD
  reason    String?
  createdAt DateTime @default(now())

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
}

model Appointment {
  id     String @id @default(cuid())
  date   String @db.Char(10) // YYYY-MM-DD (hospital local date)
  time   String @db.Char(5)  // HH:mm
  reason String?
  patientName String
  patientAge  Int?
  status      AppointmentStatus @default(PENDING)
  tokenNumber Int?
  note        String? // reason given on reject/cancel
  // Requests not approved by this time expire automatically
  approveBy   DateTime?
  paidAt      DateTime? // desk pressed "Paid"
  reminderSentAt DateTime? // 2-hour reminder queued
  calledAt       DateTime? // desk pressed "Call next" for this token
  tokenNearAt    DateTime? // "your turn is near" alert sent
  walkIn      Boolean   @default(false)
  walkInPhone String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Null for walk-ins and for accounts that were deleted
  userId     String?
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  profileId  String?
  profile    PatientProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  events     AppointmentEvent[]
  review     Review?
  // Set when the booking came from a sponsored card (promotion analytics)
  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  doctorId   String
  doctor     Doctor   @relation(fields: [doctorId], references: [id])
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@index([doctorId, date])
  @@index([hospitalId, status])
  @@index([status, approveBy])
}

/// Audit trail: one row per status change.
model AppointmentEvent {
  id        String             @id @default(cuid())
  action    String // book, approve, confirm, reject, cancel, reschedule, expire, arrive, no_show, paid, leave
  from      AppointmentStatus?
  to        AppointmentStatus
  note      String?
  actorId   String? // null = system
  createdAt DateTime           @default(now())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

/// A text message waiting to be sent, sent, or failed. A worker sends these; API requests never wait on MSG91.
model OutboundMessage {
  id            String        @id @default(cuid())
  kind          MessageKind
  phone         String
  // Values for the DLT template's variables, e.g. { token, doctor, when, hospital }
  vars          Json
  status        MessageStatus @default(QUEUED)
  provider      String? // msg91 | console
  providerId    String?
  attempts      Int           @default(0)
  lastError     String?
  nextAttemptAt DateTime      @default(now())
  sentAt        DateTime?
  createdAt     DateTime      @default(now())

  userId        String?
  appointmentId String?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

/// In-app updates for a patient (the bell). Text messages go through OutboundMessage.
model Notification {
  id            String    @id @default(cuid())
  title         String
  body          String
  appointmentId String?
  channel       String    @default("IN_APP") // IN_APP | WHATSAPP | SMS
  sentAt        DateTime?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  type        EventType
  startsAt    DateTime
  endsAt      DateTime
  venue       String
  isFree      Boolean  @default(true)
  seats       Int?
  createdAt   DateTime @default(now())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

// Paid placement managed by the platform admin.
model Promotion {
  id        String   @id @default(cuid())
  title     String
  // Short line shown on the recommendation card
  highlight String
  priority  Int      @default(1) // higher shows first
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  // Promotions are archived, never deleted, so the record of what was sold stays (audit trail)
  archivedAt  DateTime?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  stats      PromotionStat[]
  bookings   Appointment[]
}

/// Daily counts for a promotion. No personal data: just numbers.
model PromotionStat {
  date        String @db.Char(10) // IST day, YYYY-MM-DD
  impressions Int    @default(0) // sponsored card shown in recommendations
  clicks      Int    @default(0) // hospital opened from that card
  bookings    Int    @default(0) // booking at that hospital in the same session

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, date])
}

/// A review from a patient whose visit was marked Arrived. One per visit.
model Review {
  id         String   @id @default(cuid())
  rating     Int // 1–5
  comment    String?
  // Shown publicly as first name + initial, e.g. "Riya P."
  displayName String
  hidden     Boolean  @default(false)
  hiddenReason String?
  createdAt  DateTime @default(now())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  hospitalId    String
  hospital      Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctorId      String
  userId        String?

  @@index([hospitalId, hidden, createdAt])
}

/// Who did what in the admin console, including every view of patient data.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String // e.g. users.view, application.approve, promotion.archive
  target    String? // id of the thing acted on
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

/// DPDP consent log: each time a person agrees to (or withdraws from) the privacy notice.
model ConsentRecord {
  id           String        @id @default(cuid())
  action       ConsentAction
  version      String // privacy notice version, e.g. 2026-11-v1
  ageConfirmed Boolean       @default(false)
  createdAt    DateTime      @default(now())

  // Kept after account deletion (set to null) as proof of what was agreed and when
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Personal-data breach or cyber incident. CERT-In wants a report within 6 hours of noticing,
/// the Data Protection Board within 72 hours.
model Incident {
  id                 String         @id @default(cuid())
  title              String
  description        String
  detectedAt         DateTime
  affectedPeople     Int?
  status             IncidentStatus @default(OPEN)
  reportedToCertInAt DateTime?
  reportedToBoardAt  DateTime?
  peopleNotifiedAt   DateTime?
  notes              String?
  createdById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status])
}

enum Role {
  USER
  HOSPITAL
  DOCTOR
  ADMIN
}

// PENDING --accept--> CONFIRMED (token) -> COMPLETED (arrived) / NO_SHOW
//    \-> REJECTED / EXPIRED / CANCELLED      \-> CANCELLED
// Auto-confirm doctors skip PENDING. DOCTOR_APPROVED is legacy (old two-step flow): no longer
// produced, kept only so earlier audit rows stay readable.
enum AppointmentStatus {
  PENDING
  DOCTOR_APPROVED
  CONFIRMED
  COMPLETED
  REJECTED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum ConsentAction {
  GRANTED
  WITHDRAWN
}

enum IncidentStatus {
  OPEN
  REPORTED
  CLOSED
}

enum MessageKind {
  TOKEN_NEAR
  CONFIRMED
  REMINDER
  REJECTED
  EXPIRED
  DOCTOR_LEAVE
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum OtpPurpose {
  LOGIN
  DELETE_ACCOUNT
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum EventType {
  HEALTH_CAMP
  WORKSHOP
  DRIVE
  SCREENING
  TALK
}
