# Copy to .env and adjust
PORT=4000
# Matches docker-compose.yml at the repo root
DATABASE_URL="postgresql://vitalyn:vitalyn@localhost:5432/vitalyn?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:3000"

# Proxies in front of the API, so rate limits see the real client IP.
# 1 = one proxy (Railway, Render, a single nginx). 2 = CDN + load balancer. false = no proxy (API reached directly).
# Or a comma-separated list of trusted proxy addresses/subnets.
TRUST_PROXY=1

# Sessions: short access token + httpOnly refresh cookie
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_DAYS=30
# "lax" if the site and API share a domain (or in local dev); "none" if they are on different sites
COOKIE_SAMESITE="lax"

# MSG91 (SMS). Leave empty in development: OTPs are then logged and shown on screen.
# Flow API: https://control.msg91.com/api/v5/flow/  (DLT-approved templates required in India)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
# Flow/template ID of your DLT-approved OTP message, and the variable name in it (##otp## -> otp)
MSG91_OTP_FLOW_ID=""
MSG91_OTP_VAR="otp"
# MSG91's Flow API documents "flow_id"; set to "template_id" if your account's API uses that name
MSG91_FLOW_FIELD="flow_id"

# One DLT-approved template per text message. Empty = that message isn't sent (shown as "skipped" in admin).
# Variables available in every template: ##name## ##token## ##doctor## ##when## ##hospital##
MSG91_FLOW_CONFIRMED=""
MSG91_FLOW_REMINDER=""
MSG91_FLOW_REJECTED=""
MSG91_FLOW_EXPIRED=""
MSG91_FLOW_DOCTOR_LEAVE=""
# "Your turn is near" also gets ##serving## (the token now being seen)
MSG91_FLOW_TOKEN_NEAR=""
